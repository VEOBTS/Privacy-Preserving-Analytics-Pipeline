# Database connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://analytics_user:analytics_pass@db:5432/analytics_db

# Path where the Paillier keypair JSON file will be saved
KEY_FILE_PATH=./keys/paillier_keys.json

# Epsilon for differential privacy noise (lower = more noise = more private)
DP_EPSILON=1.0

# How often the aggregator job runs (in seconds, 600 = 10 minutes)
AGGREGATOR_INTERVAL_SECONDS=600